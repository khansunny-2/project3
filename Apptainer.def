Bootstrap: docker
From: m.daocloud.io/docker.io/debian:bookworm-slim

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    printf '%s' '
    deb https://mirror.nju.edu.cn/debian/ bookworm main contrib non-free non-free-firmware
    deb https://mirror.nju.edu.cn/debian/ bookworm-updates main contrib non-free non-free-firmware
    deb https://mirror.nju.edu.cn/debian/ bookworm-backports main contrib non-free non-free-firmware
    deb https://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
    ' | tee /etc/apt/sources.list
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        make \
        libomp-dev \
        numactl \
        hwloc \
        libnuma1 \
        bc \
        coreutils \
        ca-certificates
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

%labels
    Maintainer SOJ
    Purpose    "Toolchain image for CA proj3 (Lennard-Jones force opt)."
    Note       "Scaffold (baseline/Makefile/bench.sh/judge.sh) is bind-mounted at /scaffold from the host."

%runscript
    exec /bin/sh -c "$@"
